#!/usr/bin/env bash
# Pre-commit guard against inline <svg> icons in documentation HTML.
#
# Why: CLAUDE.md §14 requires icons to come from the library via
# <i data-icon="name">. Inline SVGs drift in size and don't follow
# the theme. This hook blocks new inline SVGs in *-docs.html files
# unless they match an allowed exception or carry an opt-out marker.
#
# Allowed (silently):
#   - Do/Don't tick SVGs (fill="#16a34a" green check, fill="#dc2626" red X)
#   - SVGs inside <button class="page-tab"> blocks (tab icons in docs header)
#   - Lines preceded or annotated with <!-- icon-exempt: reason -->
#
# To bypass for a legit decorative case: add a comment above the SVG:
#   <!-- icon-exempt: callout line in anatomy figure -->
#   <svg ...>...</svg>

set -euo pipefail

# ---------------------------------------------------------------------------
# Derived files. skill-source/ (the org bundle) and skill-manifest.json are
# generated from the skill and design-system sources. When one of those sources
# is staged, regenerate the derived files and stage them too, so the commit is
# complete on its own. CI refuses a pull request whose derived files are stale
# and prints the fix, so a clone without hooks cannot break main — this just
# saves the round trip.
if git diff --cached --name-only --diff-filter=ACMRD \
   | grep -qE '^(VERSION|tokens\.css|foundation\.css|components\.css|icons\.js|tools/(serve\.py|ds-skill\.sh)|assets/|skill-source/SKILL\.md|\.claude/skills/effectory-design-system/)'; then
  if bash tools/regenerate.sh --quiet; then
    git add -A skill-manifest.json skill-source
  else
    echo "⚠ pre-commit: tools/regenerate.sh failed — committing anyway; CI regenerates on the pull request." >&2
  fi
fi

# Only check staged additions in *-docs.html and index.html
FILES=$(git diff --cached --name-only --diff-filter=AM | grep -E '^([a-z0-9-]+-docs\.html|index\.html)$' || true)

if [ -z "$FILES" ]; then
  exit 0
fi

VIOLATIONS=0
REPORT=""

for f in $FILES; do
  # Get the unified diff for this file, only added lines, with surrounding context
  diff_output=$(git diff --cached --unified=2 -- "$f")

  # Walk through diff lines tracking the previous line (for icon-exempt comments)
  prev_line=""
  in_page_tab=0
  line_in_file=0
  echo "$diff_output" | while IFS= read -r line; do
    # Track if we're inside a page-tab button block (tab icons are allowed)
    case "$line" in
      *'class="page-tab"'*) in_page_tab=1 ;;
      *'</button>'*) in_page_tab=0 ;;
    esac

    # Only inspect added lines (+ prefix, not +++ header)
    case "$line" in
      "+++"*) continue ;;
      "+"*)
        content="${line#+}"
        if echo "$content" | grep -qE '<svg[[:space:]>]'; then
          # Check exemptions
          if echo "$content$prev_line" | grep -qE 'icon-exempt'; then
            : # Allowed via marker
          elif echo "$content" | grep -qE 'fill="#16a34a"|fill="#dc2626"'; then
            : # Allowed: Do/Don't tick
          elif [ $in_page_tab -eq 1 ]; then
            : # Allowed: tab bar icon
          else
            echo "  $f: $content" >&2
            VIOLATIONS=$((VIOLATIONS + 1))
          fi
        fi
        ;;
    esac
    prev_line="$line"
  done
done

# Re-check by re-running the inspection in a way that aggregates count outside the subshell
# (the pipe above runs the while-loop in a subshell so VIOLATIONS doesn't propagate).
# Use a tempfile to count violations reliably.
TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT

for f in $FILES; do
  diff_output=$(git diff --cached --unified=2 -- "$f")
  in_page_tab=0
  prev_line=""
  while IFS= read -r line; do
    case "$line" in
      *'class="page-tab"'*) in_page_tab=1 ;;
      *'</button>'*) in_page_tab=0 ;;
    esac
    case "$line" in
      "+++"*) prev_line="$line"; continue ;;
      "+"*)
        content="${line#+}"
        if echo "$content" | grep -qE '<svg[[:space:]>]'; then
          if echo "$content$prev_line" | grep -qE 'icon-exempt'; then
            :
          elif echo "$content" | grep -qE 'fill="#16a34a"|fill="#dc2626"'; then
            :
          elif [ $in_page_tab -eq 1 ]; then
            :
          else
            printf '  %s\n    %s\n' "$f" "$content" >> "$TMP"
          fi
        fi
        ;;
    esac
    prev_line="$line"
  done <<< "$diff_output"
done

if [ -s "$TMP" ]; then
  echo ""
  echo "❌ pre-commit: inline <svg> detected in documentation HTML"
  echo ""
  echo "Per CLAUDE.md §14, icons must use <i data-icon=\"name\"> from the library."
  echo "The following new inline SVGs were found in this commit:"
  echo ""
  cat "$TMP"
  echo ""
  echo "Fix: replace each inline SVG with <i data-icon=\"name\"> (see iconography-docs.html)."
  echo ""
  echo "If this SVG is genuinely decorative (callout line, anatomy figure, hero illustration),"
  echo "add an opt-out comment on the line above:"
  echo ""
  echo "  <!-- icon-exempt: brief reason -->"
  echo "  <svg ...>...</svg>"
  echo ""
  exit 1
fi

# ─────────────────────────────────────────────────────────────────────────────
# Guard 2: font-size must use the type scale (12/14/16/18/20/26/32/42 px).
# Scans staged additions in *-docs.html, index.html and components.css.
# Opt-out for a genuine exception: add /* font-scale-exempt: reason */ on the line.
# ─────────────────────────────────────────────────────────────────────────────
FS_FILES=$(git diff --cached --name-only --diff-filter=AM | grep -E '^([a-z0-9-]+-docs\.html|index\.html|components\.css)$' || true)
FTMP=$(mktemp)
trap 'rm -f "$TMP" "$FTMP"' EXIT

for f in $FS_FILES; do
  while IFS= read -r line; do
    case "$line" in
      "+++"*) continue ;;
      "+"*)
        content="${line#+}"
        if echo "$content" | grep -qE 'font-size:[[:space:]]*[0-9]'; then
          val=$(echo "$content" | grep -oE 'font-size:[[:space:]]*[0-9]+(\.[0-9]+)?px' | head -1 | grep -oE '[0-9]+(\.[0-9]+)?')
          case "$val" in
            12|14|16|18|20|26|32|42|"") : ;;
            *)
              if echo "$content" | grep -qE 'font-scale-exempt'; then :; else
                printf '  %s\n    %s\n' "$f" "$content" >> "$FTMP"
              fi ;;
          esac
        fi
        ;;
    esac
  done <<< "$(git diff --cached --unified=0 -- "$f")"
done

if [ -s "$FTMP" ]; then
  echo ""
  echo "❌ pre-commit: off-scale font-size detected"
  echo ""
  echo "Font sizes must use the type scale: 12, 14, 16, 18, 20, 26, 32, 42 px"
  echo "(prefer the text-l* / body-* utilities). These added lines are off-scale:"
  echo ""
  cat "$FTMP"
  echo ""
  echo "Fix: snap to the nearest scale value."
  echo "Genuine exception? add a marker on the line: /* font-scale-exempt: reason */"
  echo ""
  exit 1
fi

# ─────────────────────────────────────────────────────────────────────────────
# Guard 3: border-radius must use a --radius-* token via var(), never a raw px.
# Scans staged additions in *-docs.html, index.html and components.css.
# Allowed: var(...), 0, percentage values (e.g. 50%). Raw px values are blocked.
# Opt-out for a genuine exception: add /* radius-exempt: reason */ on the line.
# ─────────────────────────────────────────────────────────────────────────────
RTMP=$(mktemp)
trap 'rm -f "$TMP" "$FTMP" "$RTMP"' EXIT

for f in $FS_FILES; do
  while IFS= read -r line; do
    case "$line" in
      "+++"*) continue ;;
      "+"*)
        content="${line#+}"
        # Look for a border-radius declaration whose value contains a px number.
        if echo "$content" | grep -qE 'border-radius:[^;]*[0-9]+(\.[0-9]+)?px'; then
          # Allowed if the value is sourced from a var() token or carries an opt-out marker.
          if echo "$content" | grep -qE 'var\(--radius'; then :;
          elif echo "$content" | grep -qE 'radius-exempt'; then :;
          else
            printf '  %s\n    %s\n' "$f" "$content" >> "$RTMP"
          fi
        fi
        ;;
    esac
  done <<< "$(git diff --cached --unified=0 -- "$f")"
done

if [ -s "$RTMP" ]; then
  echo ""
  echo "❌ pre-commit: raw px border-radius detected"
  echo ""
  echo "Border radius must use a --radius-* token via var():"
  echo "  --radius-sm 4 · --radius-base 6 · --radius-md 8 · --radius-lg 12 · --radius-xl 16 · --radius-full 999"
  echo "These added lines use a raw px value instead of a token:"
  echo ""
  cat "$RTMP"
  echo ""
  echo "Fix: replace the px value with the nearest token, e.g. border-radius: var(--radius-md);"
  echo "Genuine exception? add a marker on the line: /* radius-exempt: reason */"
  echo ""
  exit 1
fi

exit 0
